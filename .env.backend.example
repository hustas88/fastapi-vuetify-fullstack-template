# Backend + database environment. Local development defaults.
#
# Loaded via `env_file:` by both `db` (POSTGRES_* only) and `backend`.
# `make init` copies this to `.env.backend` with a random SECRET_KEY.
#
# For a deployment change: ENVIRONMENT (staging/production), SECRET_KEY
# (>=32 chars), AUTO_CREATE_SCHEMA=false, BACKEND_CORS_ORIGINS,
# FIRST_SUPERUSER_PASSWORD, EMAIL_PROVIDER=ses (+ SES_*), FORWARDED_ALLOW_IPS.
#
# Outside `local` the API refuses to boot while SECRET_KEY or
# FIRST_SUPERUSER_PASSWORD still hold the example values.

PROJECT_NAME=fastapi-vuetify-fullstack-template
# local | staging | production
ENVIRONMENT=local

# --- Security -------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=changethis
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Idle window; every refresh slides it forward.
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=fastapi-vuetify-fullstack-template
JWT_AUDIENCE=fastapi-vuetify-fullstack-template-web
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Database -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
# `db` is the Compose service name; use localhost:5432 on the host.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@db:5432/${POSTGRES_DB:-app}

# Creates missing tables and seeds FIRST_SUPERUSER on boot. Deployments use
# `alembic upgrade head` instead.
AUTO_CREATE_SCHEMA=true
FIRST_SUPERUSER=admin@example.com
# Change before deploying: the API refuses to start outside `local` with this value.
FIRST_SUPERUSER_PASSWORD=changethis123

# --- Email ----------------------------------------------------------------
# smtp -> Mailpit from compose.override.yml. ses -> Amazon SES.
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# SES SMTP credentials (an IAM user allowed to call ses:SendRawEmail), NOT the
# AWS secret access key. Host is derived from the region.
SES_REGION=us-east-1
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=

# Must be a verified identity in SES_REGION when EMAIL_PROVIDER=ses.
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=fastapi-vuetify-fullstack-template
