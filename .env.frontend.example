# Frontend (Vite) environment. Local development defaults; loaded by the
# `frontend` dev server via `env_file:` in compose.override.yml.
#
# The SPA is a static S3 website, so production builds need an absolute API
# origin: VITE_API_URL=https://api.example.com/api/v1

# Relative works in dev because Vite proxies /api.
VITE_API_URL=/api/v1

# The `backend` service inside Compose; localhost:8000 on the host.
VITE_PROXY_TARGET=http://backend:8000
